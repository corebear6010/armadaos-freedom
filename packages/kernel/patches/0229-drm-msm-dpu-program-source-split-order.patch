+static void dpu_plane_set_src_split_order(struct dpu_sw_pipe_cfg *pipe_cfg,
+					  struct dpu_sw_pipe_cfg *peer_cfg)
+{
+	pipe_cfg->is_right_pipe = false;
+	peer_cfg->is_right_pipe = false;
+
+	if (pipe_cfg->dst_rect.y1 != peer_cfg->dst_rect.y1 ||
+	    drm_rect_height(&pipe_cfg->dst_rect) !=
+	    drm_rect_height(&peer_cfg->dst_rect))
+		return;
+
+	if (pipe_cfg->dst_rect.x2 == peer_cfg->dst_rect.x1)
+		peer_cfg->is_right_pipe = true;
+	else if (peer_cfg->dst_rect.x2 == pipe_cfg->dst_rect.x1)
+		pipe_cfg->is_right_pipe = true;
+}
