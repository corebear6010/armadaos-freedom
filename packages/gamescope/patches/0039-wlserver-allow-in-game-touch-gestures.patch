+            self.assertEqual(self.menus(output), [], (mode, output))
+
+    def test_scaled_game_uses_output_space_for_both_edges(self):
+        # The fixture output is 1920x1080. A game half the panel resolution makes
+        # wlserver scale pointer coordinates down by 0.5, but the screen-edge
+        # zones and the travel distance are still fractions of the panel.
+        for start_x, move_x, menu in ((0.02, 0.12, "main"), (0.98, 0.88, "qam")):
+            with self.subTest(start_x=start_x, move_x=move_x, menu=menu):
+                output = self.run_fixture(
+                    "mode", "left", "focus", "game", "master", "1", "child", "1",
+                    "scale", "0.5", "0.5",
+                    "down", str(start_x), "0.5", "1",
+                    "motion", str(move_x), "0.5", "1",
+                    "up", "1", "tick", "100",
+                )
