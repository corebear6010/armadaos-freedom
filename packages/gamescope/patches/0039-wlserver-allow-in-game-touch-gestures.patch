+            )
+            self.assertEqual(self.menus(output), [f"menu {menu}"], output)
+
+    def test_passthrough_non_swipes_are_rejected(self):
+        cases = (
+            (0.50, 0.75, 0.50, 0.50),  # starts in the centre
