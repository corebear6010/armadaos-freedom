+#include <string>
+#include <unordered_map>
+#include <utility>
+
+enum GamescopePanelOrientation
+{
+    GAMESCOPE_PANEL_ORIENTATION_0 = 0
+};
+
+namespace gamescope
+{
+template <typename T>
+struct ConVar
+{
+    T m_value;
+    ConVar( const char *, T value, const char * ) : m_value( value ) {}
+    operator T() const { return m_value; }
+    const T &Get() const { return m_value; }
+    ConVar &operator=( T value ) { m_value = value; return *this; }
+};
+
+enum TouchClickMode
+{
+    Hover = 0,
+    Left = 1,
+    Right = 2,
+    Middle = 3,
+    Passthrough = 4,
+    Disabled = 5,
+    Trackpad = 6,
+    TouchClickModeCount = 7
+};
+
+namespace TouchClickModes
+{
+constexpr TouchClickMode Disabled = gamescope::Disabled;
+constexpr TouchClickMode Passthrough = gamescope::Passthrough;
+constexpr TouchClickMode Left = gamescope::Left;
+constexpr TouchClickMode Right = gamescope::Right;
+constexpr TouchClickMode Middle = gamescope::Middle;
+constexpr TouchClickMode Hover = gamescope::Hover;
+constexpr TouchClickMode Trackpad = gamescope::Trackpad;
+}
+
+class IBackendConnector
+{
+public:
+    GamescopePanelOrientation GetCurrentOrientation() const
+    {
+        return GAMESCOPE_PANEL_ORIENTATION_0;
+    }
+};
+}
+
+constexpr int WLSERVER_BUTTON_COUNT = int( gamescope::TouchClickModeCount );
+
+constexpr int WL_POINTER_BUTTON_STATE_PRESSED = 1;
+constexpr int WL_POINTER_BUTTON_STATE_RELEASED = 0;
+
+struct wlr_surface {};
+struct wlr_seat {};
+struct wlserver_wl_surface_info { bool xdg_surface = false; };
+
+struct wl_display {};
+
+struct wl_event_source
+{
+    int ( *callback )( void * ) = nullptr;
+    void *data = nullptr;
+    long due_ms = -1;
+    bool armed = false;
+};
+
+struct wl_event_loop
+{
+    wl_event_source source;
+};
+
+struct wlserver_t
+{
+    wl_display *display = nullptr;
+    wl_event_loop *event_loop = nullptr;
+    wlr_surface *mouse_focus_surface = nullptr;
+    bool mouse_focus_is_steam = false;
+    double mouse_surface_cursorx = 0.0;
+    double mouse_surface_cursory = 0.0;
+    std::set<int> touch_down_ids;
+    bool button_held[WLSERVER_BUTTON_COUNT] = {};
+    struct { wlr_seat *seat = nullptr; } wlr;
+};
+static wlserver_t wlserver;
+
+static wl_display g_display;
+static wl_event_loop g_event_loop;
+static long g_simulated_ms = 0;
+
+// One timer, like the handoff grace: add_timer stores callback/data, a
+// positive timer_update arms it relative to the fake clock, and 0 disarms.
+static wl_event_source *wl_event_loop_add_timer( wl_event_loop *loop, int ( *callback )( void * ), void *data )
+{
+    loop->source.callback = callback;
+    loop->source.data = data;
+    loop->source.armed = false;
+    loop->source.due_ms = -1;
+    return &loop->source;
+}
+
+static int wl_event_source_timer_update( wl_event_source *source, int ms )
+{
+    if ( ms <= 0 )
+    {
+        source->armed = false;
+        source->due_ms = -1;
+    }
+    else
+    {
+        source->armed = true;
+        source->due_ms = g_simulated_ms + ms;
+    }
+    return 0;
+}
+
+static int wl_event_source_remove( wl_event_source *source )
+{
+    source->armed = false;
+    source->due_ms = -1;
+    source->callback = nullptr;
+    source->data = nullptr;
+    return 0;
+}
+
+static void tick( long ms )
+{
+    g_simulated_ms += ms;
+
+    wl_event_source *source = wlserver.event_loop ? &wlserver.event_loop->source : nullptr;
+    if ( source == nullptr || !source->armed || g_simulated_ms < source->due_ms )
+        return;
+
+    int ( *callback )( void * ) = source->callback;
+    void *data = source->data;
+    source->armed = false;
+    source->due_ms = -1;
+    if ( callback != nullptr )
+        callback( data );
+}
+
+static wlr_surface g_focus_surface;
+static wlr_surface g_other_surface;
+static wlserver_wl_surface_info g_focus_surface_info;
+static wlserver_wl_surface_info g_other_surface_info;
