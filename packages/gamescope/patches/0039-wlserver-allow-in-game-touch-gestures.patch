+}
+
+void wlr_seat_touch_notify_motion( wlr_seat *, uint32_t, int id, double x, double y )
+{
+    std::cout << "touch " << id << " " << x << " " << y << "\n";
+}
+
+void wlr_seat_touch_notify_down( wlr_seat *, wlr_surface *, uint32_t, int id, double x, double y )
+{
+    std::cout << "touch_down " << id << " " << x << " " << y << "\n";
+}
+
+void wlr_seat_touch_notify_up( wlr_seat *, uint32_t, uint32_t id )
+{
+    std::cout << "touch_up " << id << "\n";
+}
+
+void wlr_seat_touch_notify_frame( wlr_seat * )
+{
+    std::cout << "touch_frame\n";
+}
+
+void wl_display_flush_clients( wl_display * )
+{
+    std::cout << "flush\n";
+}
+
+void wlr_seat_pointer_notify_button( wlr_seat *, uint32_t, int button, int state )
+{
+    std::cout << "button " << button << " " << state << "\n";
+}
+
+void wlr_seat_pointer_notify_frame( wlr_seat * ) {}
+
+static inline uint32_t TouchClickModeToLinuxButton( gamescope::TouchClickMode mode )
+{
+    switch ( mode )
+    {
+        case gamescope::Left:
+        case gamescope::Trackpad:
+            return 0x110;
+        case gamescope::Right:
+            return 0x111;
+        case gamescope::Middle:
+            return 0x112;
+        default:
+            return 0;
+    }
+}
+
+class Backend
+{
+public:
+    gamescope::TouchClickMode GetTouchClickMode() const { return m_mode; }
+    gamescope::TouchClickMode m_mode = gamescope::Passthrough;
+};
+static Backend g_backend;
+static Backend *GetBackend() { return &g_backend; }
+
+static int g_nOutputWidth = 1920;
+static int g_nOutputHeight = 1080;
+static double focusedWindowOffsetX = 0.0;
+static double focusedWindowOffsetY = 0.0;
+static double focusedWindowScaleX = 1.0;
+static double focusedWindowScaleY = 1.0;
+static std::atomic<bool> g_bPendingTouchMovement{ false };
+static bool pending_gesture_x = false;
+static bool pending_gesture_y = false;
+
+bool cv_touch_gestures = true;
+bool cv_touch_gestures_in_game = true;
+"""
+
+MAIN = r"""
+static gamescope::TouchClickMode parse_mode( const std::string &name )
+{
+    if ( name == "passthrough" ) return gamescope::Passthrough;
+    if ( name == "disabled" ) return gamescope::Disabled;
+    if ( name == "left" ) return gamescope::Left;
+    if ( name == "right" ) return gamescope::Right;
+    if ( name == "middle" ) return gamescope::Middle;
+    if ( name == "hover" ) return gamescope::Hover;
+    if ( name == "trackpad" ) return gamescope::Trackpad;
+    std::abort();
+}
+
+int main( int argc, char **argv )
+{
+    wlserver.mouse_focus_surface = &g_focus_surface;
+    wlserver.wlr.seat = nullptr;
+    wlserver.display = &g_display;
+    wlserver.event_loop = &g_event_loop;
+    uint32_t time = 1;
+
+    for ( int i = 1; i < argc; i++ )
+    {
+        std::string op = argv[i];
+        if ( op == "mode" )
+            g_backend.m_mode = parse_mode( argv[++i] );
+        else if ( op == "master" )
+            cv_touch_gestures = std::string( argv[++i] ) == "1";
+        else if ( op == "child" )
+            cv_touch_gestures_in_game = std::string( argv[++i] ) == "1";
+        else if ( op == "focus" )
+        {
+            wlserver.mouse_focus_is_steam = std::string( argv[++i] ) == "steam";
+            wlserver.mouse_focus_surface = &g_focus_surface;
+        }
+        else if ( op == "focus-other" )
+            wlserver.mouse_focus_surface = &g_other_surface;
+        else if ( op == "scale" )
+        {
+            focusedWindowScaleX = std::atof( argv[++i] );
+            focusedWindowScaleY = std::atof( argv[++i] );
+        }
+        else if ( op == "down" )
+        {
+            double x = std::atof( argv[++i] );
+            double y = std::atof( argv[++i] );
+            int id = std::atoi( argv[++i] );
+            wlserver_touchdown( x, y, id, time++, nullptr );
+        }
+        else if ( op == "motion" )
+        {
+            double x = std::atof( argv[++i] );
+            double y = std::atof( argv[++i] );
+            int id = std::atoi( argv[++i] );
+            wlserver_touchmotion( x, y, id, time++, false, nullptr );
+        }
+        else if ( op == "up" )
+        {
+            int id = std::atoi( argv[++i] );
+            wlserver_touchup( id, time++ );
+        }
+        else if ( op == "tick" )
+            tick( std::atol( argv[++i] ) );
+        else if ( op == "mark" )
+            std::cout << "mark " << argv[++i] << "\n";
+    }
+    return 0;
+}
+"""
+
+
+def extracted_region(source):
+    start = source.find("void wlserver_gesture_flush()")
+    end = source.find("gamescope_xwayland_server_t *wlserver_get_xwayland_server", start)
+    if start < 0 or end < 0:
+        raise AssertionError("could not locate the touch gesture bodies in wlserver.cpp")
+    region = source[start:end]
+    # The fixture owns the boolean globals; drop any convar declarations of them.
+    region = re.sub(
+        r"(?m)^[^\n]*\bConVar<[^>]+>\s+cv_touch_gestures(?:_in_game)?\s*\([^;]*\);\s*$",
+        "",
+        region,
+    )
+    return region
+
+
+class InGameSwipesNativeTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.directory = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.directory.cleanup)
+        compiler = shutil.which("c++") or shutil.which("g++")
+        if compiler is None:
+            raise AssertionError("no C++ compiler available for the fixture")
+        source = Path(cls.directory.name) / "fixture.cpp"
+        source.write_text(
+            PRELUDE + "\n" + extracted_region(WLSOURCE.read_text()) + "\n" + MAIN,
+            encoding="utf-8",
+        )
+        cls.executable = Path(cls.directory.name) / "fixture"
+        result = subprocess.run(
+            [compiler, "-std=c++17", "-O0", "-o", str(cls.executable), str(source)],
+            text=True, capture_output=True,
+        )
+        if result.returncode != 0:
+            raise AssertionError("fixture compile failed:\n" + result.stderr)
+
+    def run_fixture(self, *operations):
+        result = subprocess.run(
+            [str(self.executable), *operations],
+            text=True, capture_output=True, timeout=10,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return [line for line in result.stdout.splitlines() if line]
+
+    def menus(self, output):
+        return [line for line in output if line.startswith("menu ")]
+
+    def assert_mode_effect(self, mode, output):
+        if mode in ("left", "right", "middle"):
+            self.assertTrue(
+                any(line.startswith("button ") for line in output),
+                f"{mode} lost its click button: {output}",
+            )
+            self.assertTrue(
+                any(line.startswith("warp ") for line in output),
+                f"{mode} lost its pointer warp: {output}",
+            )
+        elif mode == "hover":
+            self.assertTrue(any(line.startswith("warp ") for line in output), output)
+        elif mode == "trackpad":
+            self.assertTrue(any(line.startswith("motion ") for line in output), output)
+        elif mode == "passthrough":
+            self.assertTrue(any(line.startswith("touch ") for line in output), output)
+
+    def edge_ops(self, mode, start_x, move_x, start_y=0.5, move_y=0.5, master=1, child=None,
+                 repeat_motion=False):
+        operations = ["mode", mode, "master", str(master)]
+        if child is not None:
+            operations.extend(["child", str(child)])
+        operations.extend([
+            "down", str(start_x), str(start_y), "1",
+            "motion", str(move_x), str(move_y), "1",
+        ])
+        if repeat_motion:
+            # Repeated motion must land before the finger lifts.
+            operations.extend(["motion", str(move_x), str(move_y), "1"])
+        # Every swipe now finishes with the lift and the post-lift grace.
+        operations.extend(["up", "1", "tick", "100"])
+        return operations
+
+    def test_passthrough_edge_swipes_open_once(self):
+        for start_x, move_x, menu in ((0.02, 0.20, "main"), (0.98, 0.80, "qam")):
+            output = self.run_fixture(
