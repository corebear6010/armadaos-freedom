+// Native Steam UI 60Hz policy glue. Capability only describes the current
+// output, never whether the mode has actually been applied.
+static uint32_t
+steamui_supported_refresh()
+{
+	gamescope::IBackend *pBackend = GetBackend();
+	if ( !pBackend || !pBackend->IsSessionBased() )
+		return 0;
+
+	gamescope::IBackendConnector *pConnector = pBackend->GetCurrentConnector();
+	if ( !pConnector || pConnector->IsHeadless() )
+		return 0;
+
+	const bool bNativeInternal = pConnector->GetScreenType() == gamescope::GAMESCOPE_SCREEN_TYPE_INTERNAL;
+
+	return gamescope::SteamUIRefreshSupported( bNativeInternal, pConnector->IsVRRActive(), pConnector->GetValidDynamicRefreshRates() );
+}
+
+// The 60Hz policy cap while the focused main Steam UI sits on the output we
+// drive. Overlay and input focus over a game are deliberately not looked at.
+// This is a ceiling, not the rate the UI actually runs at.
+static uint32_t
+steamui_active_refresh( global_focus_t *pFocus )
+{
+	if ( !pFocus || pFocus != GetCurrentFocus() )
+		return 0;
+
+	gamescope::IBackendConnector *pCurrent = GetBackend() ? GetBackend()->GetCurrentConnector() : nullptr;
+	gamescope::IBackendConnector *pConnector = pFocus->pVirtualConnector.get();
+	if ( !pConnector )
+		pConnector = pCurrent;
+
+	// A focus painted onto another output must not inherit this output's policy.
+	if ( !pConnector || !pCurrent || pConnector->GetConnectorID() != pCurrent->GetConnectorID() )
+		return 0;
+
+	steamcompmgr_win_t *pFocusWindow = pFocus->focusWindow;
+	const bool bMainSteamFocused = window_is_steam( pFocusWindow ) && !pFocusWindow->isSteamStreamingClientVideo;
+
+	return gamescope::SteamUIRefreshTarget( g_uSteamUIRefreshRateRequested, steamui_supported_refresh(), bMainSteamFocused );
+}
+
+// The only window the policy covers is the focused main Steam UI window itself.
+// Its FPS and refresh cycle stay maximums, never a forced frame rate.
+static bool
+steamui_is_active_window( steamcompmgr_win_t *w )
+{
+	global_focus_t *pFocus = GetCurrentFocus();
+	if ( !pFocus || !w || w != pFocus->focusWindow )
+		return false;
+
+	return steamui_active_refresh( pFocus ) == 60;
+}
