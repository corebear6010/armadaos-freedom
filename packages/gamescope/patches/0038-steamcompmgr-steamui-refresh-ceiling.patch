diff --git a/tests/test_utils_steam_ui_refresh.cpp b/tests/test_utils_steam_ui_refresh.cpp
new file mode 100644
index 0000000..f5a1e5a
--- /dev/null
+++ b/tests/test_utils_steam_ui_refresh.cpp
@@ -0,0 +1,93 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include "Utils/SteamUIRefresh.h"
+
+#include <cstdint>
+#include <initializer_list>
+#include <vector>
+
+using namespace gamescope;
+
+TEST_CASE("Steam UI 60Hz supported needs native internal output, no VRR and a listed 60Hz rate", "[steam_ui_refresh]") {
+	std::vector<uint32_t> y700Rates = { 30, 60, 90, 120 };
+	REQUIRE( SteamUIRefreshSupported( true, false, y700Rates ) == 60 );
+
+	// Native internal output and non-VRR are both hard gates.
+	REQUIRE( SteamUIRefreshSupported( false, false, y700Rates ) == 0 );
+	REQUIRE( SteamUIRefreshSupported( true, true, y700Rates ) == 0 );
+	REQUIRE( SteamUIRefreshSupported( false, true, y700Rates ) == 0 );
+
+	// No usable connector rates at all.
+	std::vector<uint32_t> noRates;
+	REQUIRE( SteamUIRefreshSupported( true, false, noRates ) == 0 );
+
+	// 60 must be listed explicitly, not inferred from any other rate.
+	for ( const std::vector<uint32_t> &rates : { std::vector<uint32_t>{ 30, 90, 120 }, std::vector<uint32_t>{ 120 }, std::vector<uint32_t>{ 90, 144, 160 }, std::vector<uint32_t>{ 59, 61 } } )
+		REQUIRE( SteamUIRefreshSupported( true, false, rates ) == 0 );
+}
+
+TEST_CASE("Steam UI refresh target only triggers on a focused 60Hz request over a 60Hz mode", "[steam_ui_refresh]") {
+	REQUIRE( SteamUIRefreshTarget( 60, 60, true ) == 60 );
+
+	// Focus and supported-mode gates.
+	REQUIRE( SteamUIRefreshTarget( 60, 60, false ) == 0 );
+	REQUIRE( SteamUIRefreshTarget( 60, 90, true ) == 0 );
+	REQUIRE( SteamUIRefreshTarget( 60, 120, true ) == 0 );
+	REQUIRE( SteamUIRefreshTarget( 90, 60, true ) == 0 );
+
+	// Only 60 is an enable request; these values never enable the override.
+	for ( uint32_t requestedHz : { 0u, 30u, 90u, 120u, 144u } ) {
+		REQUIRE( SteamUIRefreshTarget( requestedHz, requestedHz, true ) == 0 );
+		REQUIRE( SteamUIRefreshTarget( requestedHz, 60, true ) == 0 );
+	}
+}
+
+TEST_CASE("Steam UI window target caps only the focused Steam window and preserves game rates", "[steam_ui_refresh]") {
+	// A focused Steam window with a 60Hz UI targets 60 regardless of the game.
+	for ( int originalGameFPS : { 0, 30, 40, 120 } )
+		REQUIRE( SteamUIWindowTargetFPS( 60, true, originalGameFPS ) == 60 );
+
+	// Unfocused Steam windows and non-60 UI rates leave every window rate intact.
+	for ( int originalGameFPS : { 0, 30, 40, 120 } ) {
+		REQUIRE( SteamUIWindowTargetFPS( 60, false, originalGameFPS ) == originalGameFPS );
+		for ( uint32_t activeUIHz : { 0u, 30u, 90u, 120u } )
+			REQUIRE( SteamUIWindowTargetFPS( activeUIHz, true, originalGameFPS ) == originalGameFPS );
+	}
+}
+
+TEST_CASE("Steam UI output rate ceiling is a maximum and never raises a slower base mode", "[steam_ui_refresh]") {
+	// The ceiling only lowers. A 30Hz or 50Hz base mode stays where it is.
+	REQUIRE( SteamUIOutputRefreshRate( 60, 30 ) == 30 );
+	REQUIRE( SteamUIOutputRefreshRate( 60, 50 ) == 50 );
+	REQUIRE( SteamUIOutputRefreshRate( 60, 60 ) == 60 );
+	REQUIRE( SteamUIOutputRefreshRate( 60, 90 ) == 60 );
+	REQUIRE( SteamUIOutputRefreshRate( 60, 165 ) == 60 );
+
+	// No policy, or a policy other than 60, leaves the base mode alone.
+	REQUIRE( SteamUIOutputRefreshRate( 0, 30 ) == 30 );
+	REQUIRE( SteamUIOutputRefreshRate( 0, 50 ) == 50 );
+	REQUIRE( SteamUIOutputRefreshRate( 0, 60 ) == 60 );
+	REQUIRE( SteamUIOutputRefreshRate( 0, 165 ) == 165 );
+	REQUIRE( SteamUIOutputRefreshRate( 90, 30 ) == 30 );
+	REQUIRE( SteamUIOutputRefreshRate( 90, 165 ) == 165 );
+}
+
+TEST_CASE("Steam UI window cycle ceiling keeps a window that already runs slower", "[steam_ui_refresh]") {
+	// A 50Hz window keeps 20ms and a 30Hz window keeps 33.3ms.
+	REQUIRE( SteamUIWindowRefreshCycle( 60, true, 20000000, 33333333 ) == 20000000 );
+	REQUIRE( SteamUIWindowRefreshCycle( 60, true, 33333333, 8333333 ) == 33333333 );
+
+	// At 60Hz or faster the ceiling bounds the window to the 60Hz period.
+	REQUIRE( SteamUIWindowRefreshCycle( 60, true, 16666667, 16666667 ) == 16666667 );
+	REQUIRE( SteamUIWindowRefreshCycle( 60, true, 11111111, 11111111 ) == 16666667 );
+	REQUIRE( SteamUIWindowRefreshCycle( 60, true, 6060606, 6060606 ) == 16666667 );
+}
+
+TEST_CASE("Steam UI window cycle ceiling is ignored when disabled or not the UI window", "[steam_ui_refresh]") {
+	for ( uint64_t originalCycle : { 25000000ull, 33333333ull, 8333333ull } ) {
+		// Disabled policy, another window, and a non-60 policy all keep the original.
+		REQUIRE( SteamUIWindowRefreshCycle( 0, true, 11111111, originalCycle ) == originalCycle );
+		REQUIRE( SteamUIWindowRefreshCycle( 60, false, 11111111, originalCycle ) == originalCycle );
+		REQUIRE( SteamUIWindowRefreshCycle( 90, true, 11111111, originalCycle ) == originalCycle );
+	}
+}
