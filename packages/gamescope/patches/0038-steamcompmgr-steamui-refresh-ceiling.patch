@@ -0,0 +1,76 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <span>
+
+#include "../refresh_rate.h"
+
+namespace gamescope
+{
+    // Native Steam UI refresh policy.
+    //
+    // The Steam main UI gets a 60Hz ceiling on the internal panel, with VRR off
+    // and 60Hz explicitly listed by the connector. That ceiling is a maximum,
+    // never a forced rate: a slower base mode is left alone, no frames are
+    // generated to reach it and nothing idles in a repaint loop. The request
+    // and the supported value are policy, not applied Hz. Every helper returns
+    // its "no preference" result when the policy does not hold.
+
+    // 60 iff the internal panel is native output, VRR is off and 60Hz is listed.
+    inline uint32_t SteamUIRefreshSupported( bool nativeInternalOutput, bool activeVRR, std::span<const uint32_t> validRates )
+    {
+        if ( !nativeInternalOutput || activeVRR )
+            return 0;
+
+        for ( uint32_t rate : validRates )
+            if ( rate == 60 )
+                return 60;
+
+        return 0;
+    }
+
+    // Request + support + focus: the 60Hz policy cap applies. This is a ceiling
+    // on the UI, not the mode in use and not an applied Hz.
+    inline uint32_t SteamUIRefreshTarget( uint32_t requestedHz, uint32_t supportedHz, bool mainSteamFocused )
+    {
+        if ( requestedHz == 60 && supportedHz == 60 && mainSteamFocused )
+            return 60;
+
+        return 0;
+    }
+
+    // Maximum FPS for the Steam window, not a promise that it runs at 60.
+    inline int SteamUIWindowTargetFPS( uint32_t activeUIHz, bool targetSteamWindow, int originalGameFPS )
+    {
+        if ( activeUIHz == 60 && targetSteamWindow )
+            return 60;
+
+        return originalGameFPS;
+    }
+
+    // Final output rate for a paint under the policy ceiling. The base mode is
+    // whatever was already chosen; the ceiling may only lower it. A 30Hz or
+    // 50Hz base mode is not raised, and no mode is selected here.
+    inline int SteamUIOutputRefreshRate( uint32_t policyCapHz, int originalBaseHz )
+    {
+        // Lower only: the ceiling never raises an existing 30/50Hz mode.
+        if ( policyCapHz == 60 )
+            return std::min( originalBaseHz, 60 );
+
+        return originalBaseHz;
+    }
+
+    // Refresh cycle for a window's presentation feedback under the policy
+    // ceiling. "No faster than 60Hz" leaves a window that already paces itself
+    // slower on its own period.
+    inline uint64_t SteamUIWindowRefreshCycle( uint32_t policyCapHz, bool targetSteamWindow, uint64_t actualAppRefreshCycle, uint64_t originalWindowRefreshCycle )
+    {
+        // No faster than 60Hz: a window already pacing itself slower keeps its
+        // own period. Both operands are uint64_t so std::max has one type.
+        if ( policyCapHz == 60 && targetSteamWindow )
+            return std::max( actualAppRefreshCycle, uint64_t{ mHzToRefreshCycle( ConvertHztomHz( 60 ) ) } );
+
+        return originalWindowRefreshCycle;
+    }
+}
