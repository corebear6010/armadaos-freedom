#!/bin/sh
set -eu

compat=${ARMADA_ADSP_DT_COMPATIBLE:-/sys/firmware/devicetree/base/compatible}

# The root filesystem is shared by several boards. Match the DT compatible as
# one NUL-delimited token so this helper never touches another board's ADSP.
if ! grep -azFxq lenovo,elden "$compat" 2>/dev/null; then
    echo "device is not lenovo,elden; nothing to do"
    exit 0
fi

firmware=${ARMADA_ADSP_FIRMWARE:-/usr/lib/firmware/qcom/sm8750/adsp.mdt}
expected_firmware=${ARMADA_ADSP_EXPECTED_FIRMWARE:-qcom/sm8750/adsp.mdt}
remoteproc_dir=${ARMADA_ADSP_REMOTEPROC_DIR:-/sys/class/remoteproc}
battery_dir=${ARMADA_ADSP_BATTERY_DIR:-/sys/class/power_supply/battery}
[ -r "$firmware" ] || {
    echo "ADSP firmware is not readable: $firmware" >&2
    exit 1
}

found=0
for rproc in "$remoteproc_dir"/remoteproc*; do
    [ -r "$rproc/name" ] || continue
    [ "$(cat "$rproc/name")" = adsp ] || continue

    firmware_name=$(cat "$rproc/firmware" 2>/dev/null || true)
    if [ "$firmware_name" != "$expected_firmware" ]; then
        echo "Skipping ADSP $rproc with unexpected firmware: $firmware_name" >&2
        continue
    fi

    found=1

    state=$(cat "$rproc/state")
    echo "ADSP $rproc initial state: $state"

    if [ "$state" = offline ]; then
        echo start > "$rproc/state"
    fi

    if [ "$state" != running ]; then
        for _ in $(seq 1 100); do
            state=$(cat "$rproc/state")
            [ "$state" = running ] && break
            [ "$state" = offline ] && break
            sleep 0.1
        done
    fi

    [ "$state" = running ] || {
        echo "ADSP failed to reach running state: $state" >&2
        exit 1
    }
done

[ "$found" -eq 1 ] || {
    echo "No ADSP remoteproc device found" >&2
    exit 1
}

# UPower starts after this unit, so battery properties are ready before its
# initial enumeration. This avoids cached 0% / 0 Wh values from an early probe.
positive_integer() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt "$2" ]
}

battery_ready=0
for _ in $(seq 1 100); do
    capacity=$(cat "$battery_dir/capacity" 2>/dev/null || true)
    voltage=$(cat "$battery_dir/voltage_now" 2>/dev/null || true)
    if positive_integer "$capacity" 0 &&
            positive_integer "$voltage" 3000000; then
        battery_ready=1
        break
    fi
    sleep 0.1
done

[ "$battery_ready" -eq 1 ] || {
    echo "Battery capacity or voltage is not ready" >&2
    exit 1
}

echo "ADSP is running"
