[Unit]
Description=Grow the Armada EDL ROOT filesystem into its preallocated partition
ConditionPathExists=/etc/armada/edl-direct.json
ConditionPathExists=!/var/lib/armada/edl-root-expanded
Requires=local-fs.target
After=local-fs.target
RequiresMountsFor=/var
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/armada/armada-edl-grow-root /etc/armada/edl-direct.json /var/lib/armada/edl-root-expanded
RemainAfterExit=yes
StateDirectory=armada
StateDirectoryMode=0755
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
